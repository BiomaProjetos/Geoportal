# Copie para .env (o install.sh faz isso e gera as senhas). NUNCA envie o .env para o GitHub.

# Endereço do geoportal (o DNS precisa apontar para o IP da VPS)
DOMINIO=geo.solucoesagroambientais.com

# Gerados automaticamente pelo install.sh
DB_SENHA=
SEGREDO_JWT=

# Horas até a sessão expirar
SESSAO_HORAS=12

# Fase 2 — busca automática do CAR no Geoportal SEMA-MT (deixe vazio até confirmar o uso da authkey)
# A URL e o typename estão no arquivo wfsrequest.txt que vem dentro de cada exportação SHP do Geoportal.
SEMA_WFS_URL=
SEMA_AUTHKEY=
SEMA_TYPENAME_ATP=Geoportal:MVW_REQUERIMENTO_ATP
SEMA_CAMPO_CAR=NUMEROESTADUAL
